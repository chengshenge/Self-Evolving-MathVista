# MUSE runtime configuration.
# Keep MOCK_MODE=1 for smoke tests. Set MOCK_MODE=0 for real model calls.
MOCK_MODE=1

# Save successful seed traces as reusable generated skills.
SAVE_GENERATED_SKILLS=1
MAX_RECHECKS=1

# Optional: isolate generated skills between experiments.
MUSE_GENERATED_SKILLS_ROOT=

# Optional: use a different env file, e.g. MUSE_ENV_FILE=/path/to/.env.gpt
MUSE_ENV_FILE=

# Simple OpenAI-compatible default endpoint. These fan out to all stages unless
# a stage-specific override below is set.
BASE_URL=
API_KEY=
MODEL=
MODEL_PROTOCOL=OPENAI_STYLE
DEFAULT_TIMEOUT=120
DEFAULT_TEMPERATURE=0.0

# Stage-specific overrides.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_TIMEOUT=120
VISION_TEMPERATURE=0.0

REASONING_BASE_URL=
REASONING_API_KEY=
REASONING_MODEL=
REASONING_TIMEOUT=120
REASONING_TEMPERATURE=0.0

ORCHESTRATOR_BASE_URL=
ORCHESTRATOR_API_KEY=
ORCHESTRATOR_MODEL=
ORCHESTRATOR_TIMEOUT=120
ORCHESTRATOR_TEMPERATURE=0.0
